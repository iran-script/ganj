# Copy to a protected operator-owned env file; never commit real values.
NEXO_RELEASE_ID=rc-<immutable-git-sha>
NEXO_APP_IMAGE=nexo-app:rc-<immutable-git-sha>
NEXO_CONTROL_IMAGE=nexo-control:rc-<immutable-git-sha>
NEXO_NGINX_IMAGE=nexo-nginx:rc-<immutable-git-sha>
NEXO_DOMAIN=__REQUIRED_VERIFIED_PRODUCTION_DOMAIN__
NEXO_HTTP_BIND_IP=0.0.0.0
NEXO_HTTPS_BIND_IP=0.0.0.0
NEXO_TLS_DIR=__REQUIRED_PROTECTED_TLS_DIRECTORY__
NEXO_DOCKER_NETWORK=__REQUIRED_AUDITED_NETWORK_NAME__
NEXO_APP_STORAGE_VOLUME=__REQUIRED_AUDITED_APP_STORAGE_VOLUME__
NEXO_DB_DATABASE=__REQUIRED_READ_VERIFIED_DATABASE_NAME__
NEXO_APP_ENV_FILE=__REQUIRED_PROTECTED_LARAVEL_ENV_FILE__
NEXO_CONTROL_ENV_FILE=__REQUIRED_PROTECTED_CONTROL_ENV_FILE__
