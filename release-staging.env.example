# Staging must use its own domain, certificate, network, database, volume and env files.
NEXO_RELEASE_ID=staging-<immutable-git-sha>
NEXO_APP_IMAGE=nexo-app:staging-<immutable-git-sha>
NEXO_CONTROL_IMAGE=nexo-control:staging-<immutable-git-sha>
NEXO_NGINX_IMAGE=nexo-nginx:staging-<immutable-git-sha>
NEXO_DOMAIN=__REQUIRED_VERIFIED_STAGING_DOMAIN__
NEXO_HTTP_BIND_IP=127.0.0.1
NEXO_HTTPS_BIND_IP=127.0.0.1
NEXO_TLS_DIR=__REQUIRED_STAGING_TLS_DIRECTORY__
NEXO_DOCKER_NETWORK=__REQUIRED_STAGING_NETWORK_NAME__
NEXO_APP_STORAGE_VOLUME=__REQUIRED_STAGING_APP_STORAGE_VOLUME__
NEXO_DB_DATABASE=__REQUIRED_STAGING_DATABASE_NAME__
NEXO_APP_ENV_FILE=__REQUIRED_STAGING_LARAVEL_ENV_FILE__
NEXO_CONTROL_ENV_FILE=__REQUIRED_STAGING_CONTROL_ENV_FILE__
