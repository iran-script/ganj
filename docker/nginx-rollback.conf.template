server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${NEXO_DOMAIN};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${NEXO_DOMAIN};
    server_tokens off;
    ssl_certificate /run/nexo-tls/fullchain.pem;
    ssl_certificate_key /run/nexo-tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    location ^~ /api/ {
        root /var/www/html/public;
        try_files $uri /index.php?$query_string;
    }
    location = /index.php {
        root /var/www/html/public;
        include fastcgi_params;
        fastcgi_pass nexo-app:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param HTTPS on;
    }
    location ^~ /control/ { return 503; }
    location = /login { return 503; }
    location ^~ /api/control/ { return 503; }
    location ^~ /api/backend/ { return 503; }
    location ^~ /invite/ { return 404; }
    location / { return 404; }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
