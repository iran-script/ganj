log_format nexo_safe '$remote_addr $request_method $uri $status $body_bytes_sent $request_time';

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${NEXO_DOMAIN};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${NEXO_DOMAIN};
    server_tokens off;
    client_max_body_size 26m;
    ssl_certificate /run/nexo-tls/fullchain.pem;
    ssl_certificate_key /run/nexo-tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:NEXO_TLS:10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    access_log /var/log/nginx/access.log nexo_safe;
    error_log /var/log/nginx/error.log warn;

    location ^~ /api/control/ {
        proxy_pass http://nexo-release-control:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie $http_cookie;
        proxy_hide_header X-Powered-By;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location ^~ /api/backend/ {
        proxy_pass http://nexo-release-control:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie $http_cookie;
        proxy_hide_header X-Powered-By;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location ^~ /control/ {
        proxy_pass http://nexo-release-control:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie $http_cookie;
    }

    location = /login {
        proxy_pass http://nexo-release-control:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ^~ /_next/ {
        proxy_pass http://nexo-release-control:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /invite/ {
        proxy_pass http://nexo-release-control:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = / {
        return 404;
    }

    location ^~ /api/ {
        root /var/www/html/public;
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        root /var/www/html/public;
        include fastcgi_params;
        fastcgi_pass nexo-release-app:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param HTTPS on;
        fastcgi_hide_header X-Powered-By;
    }

    location / {
        return 404;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\. {
        deny all;
    }
}
